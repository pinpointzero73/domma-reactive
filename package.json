{
  "name": "domma-reactive",
  "version": "0.4.1",
  "description": "Dependency-tracked reactivity and fine-grained DOM bindings. The reactive core of Domma, usable standalone.",
  "type": "module",
  "main": "./dist/domma-reactive.cjs",
  "module": "./dist/domma-reactive.esm.js",
  "browser": "./dist/domma-reactive.min.js",
  "exports": {
    ".": {
      "import": "./dist/domma-reactive.esm.js",
      "require": "./dist/domma-reactive.cjs",
      "default": "./dist/domma-reactive.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dist": "npm run build && node scripts/verify-dist.mjs",
    "prepublishOnly": "npm run test:run && npm run test:dist"
  },
  "keywords": ["reactive", "observable", "computed", "dependency-tracking", "template", "bindings", "domma"],
  "license": "MIT",
  "devDependencies": {
    "vitest": "^4.0.16",
    "jsdom": "^24.1.3",
    "rollup": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.4"
  }
}
