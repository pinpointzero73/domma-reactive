{
    "name": "domma-reactive",
    "version": "1.3.2",
    "description": "Dependency-tracked reactivity and fine-grained DOM bindings, with a CSP-safe expression language (no eval). The reactive core of Domma, usable standalone.",
    "author": "Darryl Waterhouse",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pinpointzero73/domma-reactive.git"
    },
    "bugs": {
        "url": "https://github.com/pinpointzero73/domma-reactive/issues"
    },
    "homepage": "https://reactive.dommajs.org",
    "type": "module",
    "main": "./dist/domma-reactive.cjs",
    "module": "./dist/domma-reactive.esm.js",
    "browser": "./dist/domma-reactive.min.js",
    "types": "./dist/domma-reactive.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/domma-reactive.d.ts",
                "default": "./dist/domma-reactive.esm.js"
            },
            "require": {
                "types": "./dist/domma-reactive.d.cts",
                "default": "./dist/domma-reactive.cjs"
            },
            "default": "./dist/domma-reactive.esm.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "README.md",
        "Tutorial.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "rollup -c",
        "test": "vitest",
        "test:run": "vitest run",
        "test:dist": "npm run build && node scripts/verify-dist.mjs",
        "test:types": "npm run build && tsc -p types/test",
        "prepublishOnly": "npm run test:run && npm run test:dist && tsc -p types/test"
    },
    "keywords": [
        "reactive",
        "observable",
        "computed",
        "dependency-tracking",
        "typescript",
        "template",
        "bindings",
        "data-binding",
        "knockout",
        "csp",
        "no-eval",
        "domma"
    ],
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.2",
        "jsdom": "^31.0.0",
        "rollup": "^4.68.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
